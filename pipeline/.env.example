# Production database (Supabase)
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Local test database (see scripts/setup-local-db.sh)
TEST_DATABASE_URL=postgresql://localhost/collegedata_test
# postgresql@17 is keg-only; add to your shell PATH:
#   export PATH="/opt/homebrew/opt/postgresql@17/bin:$PATH"
# College Scorecard API key (free: https://api.data.gov/signup/)
SCORECARD_API_KEY=
# OpenAlex API key (https://openalex.org/settings/api)
OPENALEX_API_KEY=
